{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepRein",
  "version": "0.0.1",
  "identifier": "com.deeprein.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3080"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "../backend/node",
      "../backend/plugin",
      "../backend/tools/node_modules/pnpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3QUM3NjEzQjhDNEY5Q0YKUldUUCtjUzRFM2FzeHd5NlVhQXlsSzNOQkt5MmkzYytPN1h0bGtJN2lOOWgwTStod0xpekFvYXcK",
      "endpoints": [
        "https://github.com/EvenLRs/deeprein/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
