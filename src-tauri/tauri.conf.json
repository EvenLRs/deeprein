{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deeprein",
  "version": "0.0.1",
  "identifier": "com.deeprein.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3080"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../backend/node",
      "../backend/dsh/node_modules"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
